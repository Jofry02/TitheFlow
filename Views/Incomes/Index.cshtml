@model IEnumerable<Domain.Income>

@{
    ViewData["Title"] = "Ingresos";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="page-title"><i class="bi bi-wallet2 me-2" style="color:var(--tf-primary);"></i>Ingresos</h1>
        <p class="muted-note mb-0">Gestiona los registros de ingresos y su diezmo calculado.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Registrar ingreso
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Fuente</th>
                <th>Categoría</th>
                <th class="text-end">Monto</th>
                <th class="text-end">Diezmo (10%)</th>
                <th class="text-center">Entregado</th>
                <th class="text-end">Eliminar</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
                        No hay ingresos registrados.
                    </td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.Date.ToString("yyyy-MM-dd")</td>
                    <td>
                        <span class="d-inline-flex align-items-center gap-2">
                            @item.Source
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </span>
                    </td>
                    <td>
                        <span class="badge" style="background:rgba(99,102,241,0.12); color:var(--tf-primary-dark);">
                            @(string.IsNullOrEmpty(item.Category) ? "Sin categoría" : item.Category)
                        </span>
                    </td>
                    <td class="text-end fw-bold">@item.Amount.ToString("N2")</td>
                    <td class="text-end fw-semibold" style="color:var(--tf-accent);">@item.TitheAmount.ToString("N2")</td>
                    <td class="text-center">
                        @if (item.TithePaid)
                        {
                            <span class="badge" style="background:rgba(16,185,129,0.15); color:#059669;">
                                <i class="bi bi-check-circle me-1"></i>Sí
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary bg-opacity-10" style="background:rgba(100,116,139,0.12); color:var(--tf-text-muted);">
                                <i class="bi bi-x-circle me-1"></i>No
                            </span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                            <i class="bi bi-trash3"></i> Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
