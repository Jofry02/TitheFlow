@model Domain.Income

@{
    ViewData["Title"] = "Editar ingreso";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="page-title"><i class="bi bi-pencil-square me-2" style="color:var(--tf-primary);"></i>Editar ingreso</h1>
        <p class="muted-note mb-0">El diezmo se recalcula automáticamente al guardar los cambios.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

<div class="card" style="max-width: 640px;">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Amount" class="form-label"><i class="bi bi-cash me-1"></i>Monto</label>
                <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Source" class="form-label"><i class="bi bi-tag me-1"></i>Fuente</label>
                <select asp-for="Source" class="form-select">
                    @if (!new[] { "Sueldo", "Negocio", "Venta", "Alquiler", "Inversión", "Comisión", "Extraordinario", "Donación", "Otro" }.Contains(Model.Source ?? string.Empty))
                    {
                        <option value="@Model.Source" selected>@Model.Source</option>
                    }
                    <option value="Sueldo">Sueldo</option>
                    <option value="Negocio">Negocio</option>
                    <option value="Venta">Venta</option>
                    <option value="Alquiler">Alquiler</option>
                    <option value="Inversión">Inversión</option>
                    <option value="Comisión">Comisión</option>
                    <option value="Extraordinario">Extraordinario</option>
                    <option value="Donación">Donación</option>
                    <option value="Otro">Otro</option>
                </select>
                <span asp-validation-for="Source" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Category" class="form-label"><i class="bi bi-collection me-1"></i>Categoría</label>
                <select asp-for="Category" class="form-select">
                    @if (!new[] { "Fijo", "Variable", "Extraordinario", "Otro" }.Contains(Model.Category ?? string.Empty))
                    {
                        <option value="@Model.Category" selected>@Model.Category</option>
                    }
                    <option value="Fijo">Fijo</option>
                    <option value="Variable">Variable</option>
                    <option value="Extraordinario">Extraordinario</option>
                    <option value="Otro">Otro</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Date" class="form-label"><i class="bi bi-calendar-event me-1"></i>Fecha</label>
                <input asp-for="Date" class="form-control" type="date" />
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"><i class="bi bi-card-text me-1"></i>Descripción</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-4 form-check form-switch">
                <input asp-for="TithePaid" class="form-check-input" />
                <label asp-for="TithePaid" class="form-check-label fw-semibold">
                    <i class="bi bi-check2-circle me-1"></i>Diezmo entregado
                </label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Guardar cambios
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
