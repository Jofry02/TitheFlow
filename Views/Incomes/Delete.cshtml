@model Domain.Income

@{
    ViewData["Title"] = "Eliminar ingreso";
}

<div class="text-center mb-4">
    <span class="badge mb-3" style="font-size:2.5rem; padding:1rem 1.3rem; background:rgba(244,63,94,0.12); color:#e11d48;">
        <i class="bi bi-exclamation-triangle"></i>
    </span>
    <h1 class="page-title">Eliminar ingreso</h1>
    <p class="muted-note">¿Estás seguro de que deseas eliminar este ingreso? Esta acción no se puede deshacer.</p>
</div>

<div class="card mx-auto" style="max-width: 560px;">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4 fw-semibold">Fecha</dt>
            <dd class="col-sm-8">@Model.Date.ToString("yyyy-MM-dd")</dd>
            <dt class="col-sm-4 fw-semibold">Fuente</dt>
            <dd class="col-sm-8">@Model.Source</dd>
            <dt class="col-sm-4 fw-semibold">Categoría</dt>
            <dd class="col-sm-8">
                <span class="badge" style="background:rgba(99,102,241,0.12); color:var(--tf-primary-dark);">
                    @(string.IsNullOrEmpty(Model.Category) ? "Sin categoría" : Model.Category)
                </span>
            </dd>
            <dt class="col-sm-4 fw-semibold">Monto</dt>
            <dd class="col-sm-8 fw-bold">@Model.Amount.ToString("C")</dd>
            <dt class="col-sm-4 fw-semibold">Diezmo</dt>
            <dd class="col-sm-8 fw-semibold" style="color:var(--tf-accent);">@Model.TitheAmount.ToString("C")</dd>
            <dt class="col-sm-4 fw-semibold">Descripción</dt>
            <dd class="col-sm-8">@Model.Description</dd>
        </dl>
    </div>
</div>

<div class="d-flex justify-content-center gap-2 mt-4">
    <form asp-action="Delete" method="post">
        <input asp-for="Id" type="hidden" />
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash3 me-1"></i>Eliminar
        </button>
    </form>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-x-lg me-1"></i>Cancelar
    </a>
</div>
